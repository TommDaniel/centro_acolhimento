APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Credenciais exclusivas do Docker local. Produção exige secrets próprios,
# TLS e roles de aplicação/migration com menor privilégio.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=centro_acolhimento
DB_USERNAME=centro_local
DB_PASSWORD=local_only_change_in_production
DB_SSLMODE=disable

# Contexto exclusivamente sintético para desenvolvimento local.
# Produção exige valores próprios e INSTITUTION_CONTEXT_PRODUCTION_CONFIRMED=true.
INSTITUTION_ORGANIZATION_CODE=org-demonstracao-ficticia
INSTITUTION_ORGANIZATION_NAME="Organização de Demonstração Fictícia"
INSTITUTION_UNIT_CODE=unidade-demonstracao-ficticia
INSTITUTION_UNIT_NAME="Unidade de Demonstração Fictícia"
INSTITUTION_CONTEXT_PRODUCTION_CONFIRMED=false
DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
MFA_RESTRICTED_TTL_SECONDS=300
MFA_VERIFIED_IDLE_TTL_SECONDS=900
MFA_VERIFIED_ABSOLUTE_TTL_SECONDS=28800

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
